    "obsidian",
    "obsidian-plugin"
  ],
  "homepage": "https://mnaoumov.dev/obsidian-lib/",
  "bugs": {
    "url": "https://github.com/mnaoumov/obsidian-lib/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnaoumov/obsidian-lib.git"
  },
  "license": "MIT",
  "author": "Michael Naumov",
